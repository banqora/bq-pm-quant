#!/usr/bin/env python3
"""Route plain words to the reference that answers them.

Execute this rather than reading it. It prints the path of the single best-matching reference and a
one-line reason, so the caller reads one file completely instead of browsing several.

Usage:
  pm-docs <plain words>          e.g. pm-docs "is my sharpe significant"
  pm-docs --list                 list every reference with its scope
"""
