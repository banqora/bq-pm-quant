STOPWORDS = {"the", "a", "an", "is", "are", "do", "does", "how", "what", "why", "when", "should",
             "i", "we", "my", "our", "to", "of", "for", "in", "on", "and", "or", "it", "this",
             "that", "with", "can", "be", "use", "using", "get", "make", "need"}


def score(query: str, keywords, scope: str):
    q = " " + re.sub(r"[^a-z0-9 -]", " ", query.lower()) + " "
    q = re.sub(r"\s+", " ", q)
    total = 0.0
    hits = []
    for kw in keywords:
        k = kw.strip().lower()
        if not k:
            continue
        if " " in k or "-" in k:
            if k in q:
                total += 3.0
                hits.append(kw)
        elif f" {k} " in q:
            total += 2.0
            hits.append(kw)
    for tok in q.split():
        if tok in STOPWORDS or len(tok) < 4:
            continue
        if tok in scope.lower():
            total += 0.5
    return total, hits


def main(argv):
    root = Path(__file__).resolve().parent.parent / "references"
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "--list":
        for name, scope, _ in REFS:
            print(f"{'references/' + name:<38}{scope}")
        return 0

    query = " ".join(argv)
    ranked = []
    for name, scope, kws in REFS:
        sc, hits = score(query, kws, scope)
        ranked.append((sc, name, scope, hits))
    ranked.sort(key=lambda x: -x[0])

    if ranked[0][0] == 0:
        print(f"pm-docs: no confident match for {query!r}.")
        print("Start with the SKILL.md decision path, or list the references:\n")
        for name, scope, _ in REFS:
            print(f"  {'references/' + name:<38}{scope}")
        return 1

    sc, name, scope, hits = ranked[0]
    print(f"{root / name}")
    print(f"  scope: {scope}")
    print(f"  matched: {', '.join(hits[:6]) if hits else 'scope terms'}")
    runners = [r for r in ranked[1:3] if r[0] >= sc * 0.6 and r[0] > 0]
    if runners:
        print("  also relevant:")
        for rsc, rname, rscope, _ in runners:
            print(f"    references/{rname:<32}{rscope}")
    print("\nRead the selected reference completely before acting.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
