STOPWORDS: set[str] = {
    "the", "a", "an", "is", "are", "do", "does", "how", "what", "why", "when", "should",
    "i", "we", "my", "our", "to", "of", "for", "in", "on", "and", "or", "it", "this",
    "that", "with", "can", "be", "use", "using", "get", "make", "need"}

# One routing entry per reference, which is what check-skill enforces from the outside. A
# duplicate would silently make the second entry unreachable in a tie.
if len({name for name, _scope, _keywords in REFS}) != len(REFS):
    raise RuntimeError("duplicate entry in REFS: the second would be unreachable in a tie")


def score(query: str, keywords: Sequence[str], scope: str) -> tuple[float, list[str]]:
    q = " " + re.sub(r"[^a-z0-9 -]", " ", query.lower()) + " "
    q = re.sub(r"\s+", " ", q)
    total = 0.0
    hits: list[str] = []
    for kw in keywords:
        k = kw.strip().lower()
        if not k:
            continue
        if " " in k or "-" in k:
            if k in q:
                total += 3.0
                hits.append(kw)
        elif f" {k} " in q:
            total += 2.0
            hits.append(kw)
    for tok in q.split():
        if tok in STOPWORDS or len(tok) < 4:
            continue
        if tok in scope.lower():
            total += 0.5
    return total, hits


def main(argv: Sequence[str]) -> int:
    root = Path(__file__).resolve().parent.parent / "references"
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "--list":
        for name, scope, _keywords in REFS:
            print(f"{'references/' + name:<38}{scope}")
        return 0

    query = " ".join(argv)
    ranked: list[tuple[float, str, str, list[str]]] = []
    for name, scope, keywords in REFS:
        sc, hits = score(query, keywords, scope)
        ranked.append((sc, name, scope, hits))
    ranked.sort(key=lambda x: -x[0])

    if ranked[0][0] == 0:
        print(f"pm-docs: no confident match for {query!r}.")
        print("Start with the SKILL.md decision path, or list the references:\n")
        for name, scope, _keywords in REFS:
            print(f"  {'references/' + name:<38}{scope}")
        return 1

    sc, name, scope, hits = ranked[0]
    selected = root / name
    if not selected.is_file():
        sys.stderr.write(f"pm-docs: {selected} is missing; the routing table and the references "
                         "directory disagree\n")
    print(f"{selected}")
    print(f"  scope: {scope}")
    print(f"  matched: {', '.join(hits[:6]) if hits else 'scope terms'}")
    runners = [r for r in ranked[1:3] if r[0] >= sc * 0.6 and r[0] > 0]
    if runners:
        print("  also relevant:")
        for _rsc, rname, rscope, _rhits in runners:
            print(f"    references/{rname:<32}{rscope}")
    print("\nRead the selected reference completely before acting.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
